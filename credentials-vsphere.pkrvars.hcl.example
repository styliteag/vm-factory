###############################################################################
# Vorlage fuer die vSphere-/vCenter-Werte.
#
#   cp credentials-vsphere.pkrvars.hcl.example credentials-vsphere.pkrvars.hcl
#   $EDITOR credentials-vsphere.pkrvars.hcl
#
# credentials-vsphere.pkrvars.hcl ist via .gitignore ausgenommen.
# Genutzt von:  ./build.sh vsphere ...
###############################################################################

# ---- vCenter-Verbindung ----
vsphere_server   = "vcenter.example.com"
vsphere_username = "administrator@vsphere.local"
vsphere_password = "CHANGEME"
vsphere_insecure = true # true bei selbstsigniertem Zertifikat

# ---- Platzierung ----
vsphere_datacenter = "MyDC"
vsphere_cluster    = "MyCluster"
vsphere_datastore  = "datastore1"
vsphere_network    = "VM Network" # Portgroup-Name
vsphere_folder     = "Templates"  # optional
# vsphere_host          = "esxi01.example.com"  # optional: bestimmter Host
# vsphere_resource_pool = "MyPool"              # optional

# ---- VM-Hardware (vSphere) ----
vsphere_disk_size_mb = 8192 # 8 GiB
# vm_cpu_cores / vm_memory teilen sich die Defaults mit Proxmox (2 / 2048)

# ---- HTTP (autoinstall/preseed) ----
# Falls der Build-Host mehrere IPs hat: die IP angeben, die der Gast erreicht.
# http_ip = "10.20.1.145"

# ---- Hinweise ----
# * SSH-Build-User (packer/packer), root-Keys (files/authorized_keys),
#   Zeitzone/Locale/Tastatur, root_password etc. werden mit Proxmox geteilt
#   (variables.pkr.hcl). root_password hier ueberschreibbar:
# root_password = ""
