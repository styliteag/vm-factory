###############################################################################
# Vorlage fuer die umgebungsspezifischen Werte.
#
#   cp credentials.pkrvars.hcl.example credentials.pkrvars.hcl
#   $EDITOR credentials.pkrvars.hcl
#
# credentials.pkrvars.hcl ist via .gitignore vom Versionsmanagement ausgenommen.
###############################################################################

# ---- Proxmox API-Verbindung ----
proxmox_url          = "https://pve.example.com:8006/api2/json"
proxmox_node         = "pve"                                  # pvesh get /nodes
proxmox_username     = "packer@pve!packer"                    # user@realm!tokenname
proxmox_token        = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" # Token-Secret (UUID)
proxmox_insecure_tls = true                                   # true bei selbstsigniertem Zertifikat

# ---- Storage (an die eigenen Pools anpassen) ----
vm_storage_pool  = "local-lvm" # VM-Disk
iso_storage_pool = "local"     # ISO-Download (muss ISO-Content erlauben)
efi_storage_pool = "local-lvm" # EFI-Disk

# ---- Netzwerk ----
network_bridge   = "vmbr0"
network_vlan     = 0 # 0 = kein VLAN-Tag
network_firewall = false

# Bei mehreren NICs am Build-Host die IP setzen, die der Gast erreichen soll
# (HTTP-Server fuer autoinstall/preseed). Leer = Packer waehlt automatisch.
# http_ip = "10.0.0.5"

# ---- VM-Hardware (Defaults; optional anpassen) ----
vm_cpu_cores = 2
vm_memory    = 2048
vm_disk_size = "8G"

# ---- Template-Anpassungen ----
# SSH-Keys liegen in files/authorized_keys (werden per file-Provisioner installiert).
# Sind Keys vorhanden, wird Passwort-Login deaktiviert (nur Key-Login).
# ssh_authorized_keys = ""   # optionaler Override (mehrzeilig)
#
# root-Passwort fuer Konsole/Notfall (SSH bleibt key-only):
# root_password = "..."
#
# Optional (Defaults: Europe/Berlin / C.UTF-8 / de):
# vm_timezone = "Europe/Berlin"
# vm_locale   = "C.UTF-8"
# vm_keymap   = "de"

# ---- Hinweis Storage-Format ----
# vm_storage_pool muss ein Block-Storage sein (lvmthin/zfspool/ceph/...).
# Fuer Verzeichnis-Storage ('dir') in source.pkr.hcl im disks-Block
# zusaetzlich  format = "qcow2"  setzen.
